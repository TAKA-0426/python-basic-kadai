      "source": [
        "class Human:\n",
        "    def __init__(self, name: str, age: int):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    def printinfo(self):\n",
        "        print(f\"名前: {self.name}\")\n",
        "        print(f\"年齢: {self.age}\")\n",
        "\n",
        "\n",
        "# インスタンスを変数に代入して使用\n",
        "person = Human(\"田中太郎\", 30)\n",
        "\n",
        "# メソッドを実行して出力\n",
        "person.printinfo()"
      ],
